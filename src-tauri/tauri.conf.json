{
  "productName": "MultiContext",
  "version": "0.2.0",
  "identifier": "com.unjuno.multicontext",
  "build": {
    "beforeDevCommand": "",
    "devUrl": null,
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MultiContext",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "label": "main",
        "url": "desktop-startup.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../src": "multicontext/src",
      "../public": "multicontext/public"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
