# Required: LibreChat instance with Remote Agents API enabled.
LIBRECHAT_BASE_URL=http://localhost:3080
LIBRECHAT_API_KEY=

# native: gpt-oss baseline. Requires patch-librechat + LibreChat rebuild.
# compat: stock LibreChat; MultiContext replays each local member history.
MULTICONTEXT_LIBRECHAT_MODE=native

# MultiContext server
MULTICONTEXT_HOST=127.0.0.1
MULTICONTEXT_PORT=4317
MULTICONTEXT_DATA_FILE=./data/state.json

# Public URL reachable FROM LibreChat when using generated Action specs.
# Example for Docker Desktop: http://host.docker.internal:4317
MULTICONTEXT_PUBLIC_URL=

# Optional auth
MULTICONTEXT_APP_TOKEN=
MULTICONTEXT_TOOL_SECRET=

# Request limits
MULTICONTEXT_MAX_HISTORY_MESSAGES=120
MULTICONTEXT_MAX_INSPECT_RESULTS=8
MULTICONTEXT_AGENT_TIMEOUT_MS=900000
