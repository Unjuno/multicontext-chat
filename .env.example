# Default: registration-free direct connection to a loopback OpenAI-compatible
# local model server. Omit MULTICONTEXT_BACKEND because local is the default.
MULTICONTEXT_LOCAL_MODEL_URL=http://127.0.0.1:8080

# Optional legacy compatibility only. Set MULTICONTEXT_BACKEND=librechat before
# using these values; they are not required for the normal local workflow.
# MULTICONTEXT_BACKEND=librechat
# LIBRECHAT_BASE_URL=http://localhost:3080
# LIBRECHAT_API_KEY=

# native: optional gpt-oss/LibreChat compatibility mode; requires the patch.
# compat: optional stock LibreChat mode.
# MULTICONTEXT_LIBRECHAT_MODE=native

# MultiContext server
MULTICONTEXT_HOST=127.0.0.1
MULTICONTEXT_PORT=4317
# Defaults to ./data/local-state.json for local and ./data/state.json for LibreChat.
# MULTICONTEXT_DATA_FILE=./data/local-state.json

# Optional public URL reachable FROM LibreChat when using generated Action specs.
# Example for Docker Desktop: http://host.docker.internal:4317
MULTICONTEXT_PUBLIC_URL=

# Optional auth
MULTICONTEXT_APP_TOKEN=
MULTICONTEXT_TOOL_SECRET=

# Request limits
MULTICONTEXT_MAX_HISTORY_MESSAGES=120
MULTICONTEXT_MAX_INSPECT_RESULTS=8
MULTICONTEXT_AGENT_TIMEOUT_MS=900000
